# SQLite database path.
DATABASE_URL="file:./prisma/dev.db"

# Public canonical origin. Use the real HTTPS domain in production.
SITE_URL="https://example.com"

# At least 32 random characters. Generate a strong secret before production.
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"

# Production bootstrap credential. Generate with:
# node scripts/create-admin-hash.mjs
ADMIN_PASSWORD_HASH="replace-with-generated-scrypt-hash"

# Optional for local development only. Plain passwords are intentionally
# ignored by the production bootstrap path.
# ADMIN_PASSWORD="replace-with-a-local-development-password"
