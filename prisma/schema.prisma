generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * ============================================================
 * APPOINTMENTS
 * ============================================================
 */

model Appointment {
  id String @id @default(cuid())

  trackingCode String @unique

  fullName       String
  normalizedName String
  phone          String

  dailyIdentityKey String? @unique
  activeSlotKey    String? @unique

  serviceId String

  dateKey String
  time    String

  carBrand String
  carModel String
  carYear  String?

  note String?

  washConfirmed Boolean @default(false)

  status String @default("pending")

  /**
   * customer = ثبت توسط مراجعه‌کننده
   * admin    = ثبت دستی توسط مدیر
   */
  source String @default("customer")

  cancelledAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dateKey])
  @@index([dateKey, time])
  @@index([phone])
  @@index([normalizedName])
  @@index([status])
  @@index([source])
  @@index([dateKey, phone, normalizedName])
}

/**
 * روزها و ساعت‌هایی که مدیر برای رزرو می‌بندد.
 * time = null
 * یعنی کل روز بسته است.
 */
model AppointmentBlock {
  id String @id @default(cuid())

  blockKey String @unique

  dateKey String
  time    String?

  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dateKey])
  @@index([dateKey, time])
}

/**
 * ============================================================
 * FEEDBACK
 * ============================================================
 */

model Feedback {
  id String @id @default(cuid())

  fullName String?
  phone    String?

  type    String @default("feedback")
  message String

  status String @default("new")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([phone])
}

/**
 * ============================================================
 * SITE SETTINGS
 * ============================================================
 */

model SiteSetting {
  id String @id

  businessName String
  description  String

  phone         String
  whatsappPhone String?

  address       String
  businessHours String

  instagramUrl String?
  logoUrl      String?

  /**
   * mapUrl = Google Maps
   */
  mapUrl       String?
  baladMapUrl  String?
  neshanMapUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * ============================================================
 * FAQ
 * ============================================================
 */

model Faq {
  id String @id @default(cuid())

  question String
  answer   String

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/**
 * ============================================================
 * PORTFOLIO
 * ============================================================
 */

model PortfolioItem {
  id String @id @default(cuid())

  title       String
  vehicle     String
  category    String @default("full")
  description String

  beforeImageUrl String?
  afterImageUrl  String

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/**
 * ============================================================
 * EQUIPMENT
 * ============================================================
 */

model EquipmentItem {
  id String @id @default(cuid())

  name        String
  description String
  imageUrl    String
  altText     String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([createdAt])
}

/**
 * ============================================================
 * TECHNICAL INSPECTION
 * ============================================================
 */

model TechnicalInspectionPage {
  id String @id

  title       String
  description String

  videoTitle String
  videoUrl   String?

  galleryTitle String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images TechnicalInspectionImage[]
}

model TechnicalInspectionImage {
  id String @id @default(cuid())

  pageId String

  imageUrl String

  title   String?
  caption String?
  altText String?

  sortOrder Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page TechnicalInspectionPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([pageId, isActive, sortOrder])
  @@index([createdAt])
}

/**
 * ============================================================
 * BODY INSPECTION
 * ============================================================
 */

model BodyInspectionPage {
  id String @id

  title       String
  description String

  videoTitle String
  videoUrl   String?

  galleryTitle String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images BodyInspectionImage[]
}

model BodyInspectionImage {
  id String @id @default(cuid())

  pageId String

  imageUrl String

  title   String?
  caption String?
  altText String?

  sortOrder Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page BodyInspectionPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([pageId, isActive, sortOrder])
  @@index([createdAt])
}

/**
 * ============================================================
 * ARTICLES
 * ============================================================
 */

model Article {
  id String @id @default(cuid())

  title   String
  slug    String @unique
  excerpt String
  content String

  coverImageUrl String?

  status     String  @default("draft")
  isFeatured Boolean @default(false)

  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([isFeatured])
  @@index([createdAt])
}

/**
 * ============================================================
 * ADMIN SECURITY
 * ============================================================
 */

model AdminLoginGuard {
  key String @id

  failures Int @default(0)

  windowStartedAt DateTime
  blockedUntil    DateTime?

  updatedAt DateTime @updatedAt

  @@index([blockedUntil])
}

model AdminCredential {
  id String @id

  passwordHash String

  /**
   * Hash کد ۴ رقمی لازم برای حذف دائمی.
   * null یعنی هنوز کد حذف تنظیم نشده است.
   */
  deletePinHash String?

  sessionVersion Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
